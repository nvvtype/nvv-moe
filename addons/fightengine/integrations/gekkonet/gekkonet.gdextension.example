[configuration]

entry_symbol = "gekkonet_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://addons/fightengine/integrations/gekkonet/bin/libgekkonet_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/fightengine/integrations/gekkonet/bin/libgekkonet_godot.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/fightengine/integrations/gekkonet/bin/gekkonet_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/fightengine/integrations/gekkonet/bin/gekkonet_godot.windows.template_release.x86_64.dll"
macos.debug = "res://addons/fightengine/integrations/gekkonet/bin/libgekkonet_godot.macos.template_debug.framework"
macos.release = "res://addons/fightengine/integrations/gekkonet/bin/libgekkonet_godot.macos.template_release.framework"
